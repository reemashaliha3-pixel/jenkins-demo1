# jenkins-demo

Sample Java (Maven) project used to demonstrate an automated Jenkins CI pipeline.

Pipeline stages: Checkout -> Build -> Test -> Package -> Archive

target/

pipeline {
    agent any

    // These names must match Manage Jenkins > Tools
    tools {
        maven 'Maven-3.9'
        jdk   'JDK-17'
    }

    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    // Checks GitHub for new commits every 5 minutes
    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat 'mvn -B clean compile'
            }
        }

        stage('Test') {
            steps {
                bat 'mvn -B test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            steps {
                bat 'mvn -B package -DskipTests'
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Build succeeded.'
        }
        failure {
            echo 'Build failed. Check the console output.'
        }
    }
}

